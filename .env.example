# Client configuration. Copy to `.env` and fill in.
#
# Only EXPO_PUBLIC_* variables reach the app. They are INLINED INTO THE BUNDLE
# at build time, so treat every one of them as public — never put a secret here.
# There is no such thing as a private value in a client build.

# The API, including the /api/v1 prefix.
#
#   local     http://localhost:5005/api/v1
#   deployed  https://two8-8-26-prenting-back.onrender.com/api/v1
#
# ⚠ CHANGING THIS REQUIRES `--clear`. Babel inlines the value and Metro's
# transform cache is NOT keyed on it, so a rebuild without --clear silently
# ships a bundle pointing at the previous API:
#
#   EXPO_PUBLIC_API_URL=… npx expo export -p web --clear
EXPO_PUBLIC_API_URL=http://localhost:5005/api/v1

# Optional. Overrides the API URL in development only.
#
# Without it, a physical phone running Expo Go borrows the dev server's LAN
# address, which is usually what you want. Set this when the phone and the API
# are not on the same machine.
# EXPO_PUBLIC_API_URL_DEV=http://192.168.1.5:5005/api/v1
