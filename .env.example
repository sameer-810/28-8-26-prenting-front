# Copy to .env. Only EXPO_PUBLIC_* reaches the app, and it is inlined into the
# bundle at build time — never put a secret here.

# The API ORIGIN. No /api/v1 — src/config/env.ts appends it.
#   local     http://localhost:5005
#   deployed  https://two8-8-26-prenting-back.onrender.com
#
# Changing this needs `--clear`: Metro's transform cache is not keyed on
# EXPO_PUBLIC_* values, so a rebuild without it ships the previous URL.
EXPO_PUBLIC_API_URL=http://localhost:5005

# Overrides the above in development only. Set it when the phone and the API
# are not on the same machine; otherwise Expo Go borrows the dev server's LAN
# address.
# EXPO_PUBLIC_API_URL_DEV=http://192.168.1.5:5005
