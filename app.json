{
  "expo": {
    "name": "ParentAI",
    "slug": "parentai",
    "owner": "aaishalas-team",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "scheme": "parentai",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parentai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ParentAI uses the camera to scan your child's textbook pages and worksheets."
      }
    },
    "android": {
      "package": "com.parentai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F4EC"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "ParentAI uses the camera to scan your child's textbook pages and worksheets.",
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "barcodeScannerEnabled": false
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withAndroidBuildTuning"
    ],
    "extra": {
      "eas": {
        "projectId": "57c47687-7aca-44d1-b14b-9c48bc8835c8"
      }
    }
  }
}
